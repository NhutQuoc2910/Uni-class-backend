# 1. Supabase Database Connection
# URL kết nối trực tiếp hoặc pooler (mặc định đã cấu hình sẵn cho project mbetvxgxeeraozqbsull)
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.mbetvxgxeeraozqbsull
# Điền mật khẩu database Supabase của bạn tại đây:
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD_HERE

# 2. Cấu hình gửi mail OTP qua Gmail (để trống nếu chỉ muốn test hiển thị mã ở Console)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 3. Bảo mật JWT & Cổng chạy
PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=604800000

# 4. Firebase Admin SDK (đường dẫn tới file service account nếu có)
